# Copia este archivo como .env (python -m dclake init lo hace por ti) y rellena las claves.
# Ninguna es obligatoria: si falta una, ese colector se salta y el resto sigue.

# Copernicus Climate Data Store (clima ERA5-Land, 20 años diarios). Gratis:
# 1) Crea cuenta en https://cds.climate.copernicus.eu  2) Copia tu "Personal Access Token" de tu perfil
# 3) En la página del dataset "ERA5-Land hourly time-series", pestaña Download, acepta la licencia
CDSAPI_KEY=
CDSAPI_URL=https://cds.climate.copernicus.eu/api

# NASA FIRMS (incendios diarios). Gratis, se pide con un email en:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- Ajustes locales opcionales (sustituyen a config.yaml sin editarlo) ---
# País por defecto de los comandos (ESP, JPN o USA; perfiles en config.yaml)
DCLAKE_COUNTRY=
# Periodo para ir escalando (p. ej. un año de prueba); vacío = el de config.yaml (20 años)
DCLAKE_START=
DCLAKE_END=

# --- Azure Data Lake Storage Gen2 (python -m dclake upload) ---
# Cuenta de almacenamiento con "espacio de nombres jerárquico" activado y un contenedor (p. ej. dclake).
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=dclake
AZURE_STORAGE_PREFIX=dataset
# Autenticación: un token SAS con permiso de escritura, o la clave de la cuenta, o nada si usas `az login`
AZURE_STORAGE_SAS_TOKEN=
AZURE_STORAGE_KEY=

# PeeringDB (opcional: sin clave funciona con límites de peticiones)
# https://www.peeringdb.com -> perfil -> API keys
PEERINGDB_API_KEY=

# ElevenLabs (audio a texto con Scribe v2: python -m dclake transcribe)
# La crea y guarda sola:  npx -y @elevenlabs/cli@latest onboard init   (o https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
